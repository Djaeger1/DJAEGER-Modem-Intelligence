#!/bin/sh
. /usr/lib/djaeger-modem/common.sh
. /usr/lib/djaeger-modem/adaptive.sh
. /usr/lib/djaeger-modem/gemini.sh
. /usr/lib/djaeger-modem/recovery.sh
. /usr/lib/djaeger-modem/system-intelligence.sh
. /usr/lib/djaeger-modem/rootcause.sh
. /usr/lib/djaeger-modem/root-broker.sh
. /usr/lib/djaeger-modem/decision-engine.sh
LOCK=/tmp/djaeger-modem.lock; OWNER=$LOCK/owner
proc_starttime(){ awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
owner_alive(){ [ -f "$OWNER" ] || return 1; OPID="$(sed -n '1p' "$OWNER")"; OBIRTH="$(sed -n '2p' "$OWNER")"; case "$OPID" in ''|*[!0-9]*) return 1;; esac; [ "$OPID" -gt 1 ] 2>/dev/null || return 1; [ -r "/proc/$OPID/stat" ] || return 1; [ "$(proc_starttime "$OPID")" = "$OBIRTH" ] || return 1; tr '\0' ' ' < "/proc/$OPID/cmdline" 2>/dev/null | grep -q 'djaeger-modemd'; }
acquire_lock(){ if ! mkdir "$LOCK" 2>/dev/null; then owner_alive && return 1; rm -rf "$LOCK"; mkdir "$LOCK" 2>/dev/null || return 1; fi; printf '%s\n%s\n' "$$" "$(proc_starttime $$)" > "$OWNER"; }
release_lock(){ [ -f "$OWNER" ] || return 0; [ "$(sed -n '1p' "$OWNER")" = "$$" ] && rm -rf "$LOCK"; }
acquire_lock || exit 73; STOP=0; trap 'STOP=1' INT TERM HUP; trap release_lock EXIT
MODEM_URL="$(uciopt modem_url http://192.168.8.1)"; GW="$(uciopt gateway 192.168.8.1)"; INTERVAL="$(uciopt interval 15)"; FAIL_NEED="$(uciopt confirm_failures 3)"; REC_NEED="$(uciopt recover_confirmations 2)"
FAILS=0; GOODS=0; CUR=STARTING; INCIDENT_START=0; INCIDENT_CAUSE=NONE; INCIDENT_CONF=0; LAST_RECOVERY=0; RECOVERY_COUNT=0; RECOVERY_WINDOW=0; LAST_ACTION=NONE; LAST_GEMINI=0; RECOVERY_STAGE=0; RECOVERY_STAGE_AT=0; ROOT_DOMAIN=UNKNOWN; ROOT_REASON=STARTING; ROOT_CONF=0; AI_DECISION_SOURCE=NONE; AI_DECISION_ACTION=NONE; AI_DECISION_CONF=0
adaptive_init; [ -f "$RING" ] || echo 'epoch,state,modem,service,sim,conn,wanip,rsrp,rsrq,rssi,sinr,pci,cell,gw,internet,dns,score,cause,confidence' > "$RING"; [ -f "$INCIDENTS" ] || echo 'start_epoch,end_epoch,duration,cause,confidence,recovery' > "$INCIDENTS"
fetch(){ wget -qO- --timeout=4 --header="Cookie: $SESSION" --header="__RequestVerificationToken: $TOKEN" "$MODEM_URL/api/$1" 2>/dev/null; }; session(){ X="$(wget -qO- --timeout=4 "$MODEM_URL/api/webserver/SesTokInfo" 2>/dev/null)"; SESSION="$(xmlv "$X" SesInfo)"; TOKEN="$(xmlv "$X" TokInfo)"; [ -n "$SESSION" ] && [ -n "$TOKEN" ]; }; probe(){ ping -c 1 -W 2 "$1" >/dev/null 2>&1; }; dnsprobe(){ nslookup example.com 127.0.0.1 >/dev/null 2>&1 || nslookup example.com >/dev/null 2>&1; }
classify(){ CAUSE=NONE; CONF=50; SCORE=100; if [ "$MODEM_OK" = 0 ]; then CAUSE=MODEM_UNREACHABLE; CONF=96; SCORE=10; elif [ "$SIM" != 1 ] && [ -n "$SIM" ]; then CAUSE=SIM_OR_MODEM_SERVICE; CONF=95; SCORE=20; elif [ "$SERVICE" != 2 ] && [ -n "$SERVICE" ]; then CAUSE=MODEM_PRESENT_BUT_NO_NETWORK; CONF=94; SCORE=25; elif [ -z "$WANIP" ]; then CAUSE=DATA_SESSION_LOST; CONF=91; SCORE=35; elif [ "$GWOK" = 0 ]; then CAUSE=MODEM_PATH_FAILURE; CONF=90; SCORE=30; elif [ "$INET" = 0 ]; then CAUSE=UPSTREAM_OR_DATA_SESSION; CONF=88; SCORE=45; elif [ "$DNSOK" = 0 ]; then CAUSE=DNS_FAILURE; CONF=94; SCORE=60; else S="$(num "$SINR")"; Q="$(num "$RSRQ")"; P="$(num "$RSRP")"; [ -n "$S" ] && [ "$S" -lt 0 ] 2>/dev/null && { CAUSE=RADIO_DEGRADED; CONF=82; SCORE=55; }; [ -n "$Q" ] && [ "$Q" -lt -17 ] 2>/dev/null && { CAUSE=RADIO_DEGRADED; CONF=86; SCORE=50; }; [ -n "$P" ] && [ "$P" -lt -110 ] 2>/dev/null && { CAUSE=RADIO_DEGRADED; CONF=88; SCORE=45; }; fi; }
maybe_gemini(){ gemini_enabled || return 0; TH="$(uciopt gemini_risk_threshold 50)"; GI="$(uciopt gemini_min_interval 900)"; N="$(date +%s)"; NEED=0; [ "${AI_RISK:-0}" -ge "$TH" ] 2>/dev/null && NEED=1; case "$CUR" in OUTAGE|RECOVERING) NEED=1;; esac; [ "$NEED" = 1 ] || return 0; [ $((N-LAST_GEMINI)) -ge "$GI" ] 2>/dev/null || return 0; LAST_GEMINI=$N; gemini_advise || true; }
legacy_recover(){ N="$(date +%s)"; case "$CUR" in OUTAGE|RECOVERING) :;; *) return 0;; esac; case "$ROOT_DOMAIN" in OPENWRT_DNS|DNS_UPSTREAM|OPENWRT_RESOURCE_PRESSURE|USB_MODEM_PATH|OPENWRT_SYSTEM|OPENWRT_PREFAILURE) return 0;; esac; if [ "$RECOVERY_STAGE" -eq 0 ]; then if recover_connectivity; then RECOVERY_STAGE=1; RECOVERY_STAGE_AT=$N; CUR=RECOVERING; fi; return 0; fi; WAIT="$(uciopt recovery_verify_wait 75)"; [ $((N-RECOVERY_STAGE_AT)) -ge "$WAIT" ] 2>/dev/null || return 0; [ "$RECOVERY_STAGE" -eq 1 ] || return 0; case "$ROOT_DOMAIN" in CELLULAR|MODEM|MODEM_DATA_SESSION|MULTI_FACTOR) if [ "$(uciopt allow_modem_post 0)" = 1 ] && [ "$(uciopt allow_modem_reboot 0)" = 1 ]; then if recover_modem_reboot; then recovery_record "$INCIDENT_CAUSE" WAN_RECONNECT FAILED_VERIFICATION; RECOVERY_STAGE=2; RECOVERY_STAGE_AT=$N; CUR=RECOVERING; fi; fi;; esac; }
recovery_orchestrate(){ AI_DECISION_SOURCE=NONE; AI_DECISION_ACTION=NONE; AI_DECISION_CONF=0; case "$CUR" in OUTAGE|RECOVERING) :;; *) return 0;; esac; D="$(decision_choose)"; AI_DECISION_SOURCE="${D%%:*}"; R="${D#*:}"; AI_DECISION_ACTION="${R%%:*}"; AI_DECISION_CONF="${R#*:}"; if [ "$(uciopt autonomous_root_recovery 0)" != 1 ]; then legacy_recover; return 0; fi; [ "$(uciopt self_heal 0)" = 1 ] || return 0; [ "$AI_DECISION_ACTION" != NONE ] || return 0; if decision_execute_selected "$AI_DECISION_SOURCE" "$AI_DECISION_ACTION" "$AI_DECISION_CONF"; then LAST_ACTION="$AI_DECISION_ACTION"; RECOVERY_STAGE=1; RECOVERY_STAGE_AT="$(date +%s)"; CUR=RECOVERING; log "AI_RECOVERY source=$AI_DECISION_SOURCE action=$AI_DECISION_ACTION confidence=$AI_DECISION_CONF domain=$ROOT_DOMAIN"; fi; }
write_state(){ cat > "$STATE.tmp" <<EOF
updated=$(date +%s)
state=$CUR
score=$SCORE
cause=$CAUSE
confidence=$CONF
root_domain=$ROOT_DOMAIN
root_reason=$ROOT_REASON
root_confidence=$ROOT_CONF
system_risk=${SYS_RISK:-0}
system_reason=${SYS_REASON:-UNKNOWN}
modem=$MODEM_OK
service=$SERVICE
sim=$SIM
connection=$CONN
wan_ip=$WANIP
rsrp=$RSRP
rsrq=$RSRQ
rssi=$RSSI
sinr=$SINR
pci=$PCI
cell_id=$CELL
gateway=$GWOK
internet=$INET
dns=$DNSOK
self_heal=$(uciopt self_heal 0)
last_action=$LAST_ACTION
recovery_count=$RECOVERY_COUNT
recovery_stage=$RECOVERY_STAGE
adaptive_samples=${AI_N:-0}
adaptive_risk=${AI_RISK:-0}
adaptive_reason=${AI_REASON:-LEARNING}
ai_authority=$([ "$(uciopt autonomous_root_recovery 0)" = 1 ] && echo ACTIVE || echo SHADOW)
ai_decision_source=$AI_DECISION_SOURCE
ai_decision_action=$AI_DECISION_ACTION
ai_decision_confidence=$AI_DECISION_CONF
EOF
chmod 600 "$STATE.tmp"; mv "$STATE.tmp" "$STATE"; }
while [ "$STOP" = 0 ]; do NOW=$(date +%s); MODEM_OK=0; SIG=''; STAT=''; if session; then SIG="$(fetch device/signal)"; STAT="$(fetch monitoring/status)"; echo "$SIG$STAT" | grep -q '<response>' && MODEM_OK=1; fi; SERVICE="$(xmlv "$STAT" ServiceStatus)"; SIM="$(xmlv "$STAT" SimStatus)"; CONN="$(xmlv "$STAT" ConnectionStatus)"; WANIP="$(xmlv "$STAT" WanIPAddress)"; RSRP="$(xmlv "$SIG" rsrp)"; RSRQ="$(xmlv "$SIG" rsrq)"; RSSI="$(xmlv "$SIG" rssi)"; SINR="$(xmlv "$SIG" sinr)"; PCI="$(xmlv "$SIG" pci)"; CELL="$(xmlv "$SIG" cell_id)"; probe "$GW" && GWOK=1 || GWOK=0; probe 1.1.1.1 && INET=1 || { probe 8.8.8.8 && INET=1 || INET=0; }; dnsprobe && DNSOK=1 || DNSOK=0; classify; system_collect; BAD=0; [ "$MODEM_OK" = 0 ] && BAD=1; [ "$GWOK" = 0 ] && BAD=1; [ "$INET" = 0 ] && BAD=1; [ -n "$SERVICE" ] && [ "$SERVICE" != 2 ] && BAD=1; [ -n "$SIM" ] && [ "$SIM" != 1 ] && BAD=1; [ "$BAD" = 1 ] && FAILS=$((FAILS+1)) || FAILS=0; if [ "$BAD" = 1 ]; then GOODS=0; if [ "$FAILS" -ge "$FAIL_NEED" ]; then case "$CUR" in OUTAGE|RECOVERING) :;; *) CUR=OUTAGE; INCIDENT_START=$NOW; INCIDENT_CAUSE=$CAUSE; INCIDENT_CONF=$CONF; RECOVERY_STAGE=0; RECOVERY_STAGE_AT=0; LAST_ACTION=NONE;; esac; else CUR=SUSPECT; fi; else GOODS=$((GOODS+1)); case "$CUR" in OUTAGE|RECOVERING) if [ "$GOODS" -ge "$REC_NEED" ]; then DUR=$((NOW-INCIDENT_START)); [ "$INCIDENT_START" -gt 0 ] || DUR=0; echo "$INCIDENT_START,$NOW,$DUR,$INCIDENT_CAUSE,$INCIDENT_CONF,$LAST_ACTION" >> "$INCIDENTS"; recovery_record "$INCIDENT_CAUSE" "$LAST_ACTION" SUCCESS; recovery_learn "$INCIDENT_CAUSE" "$LAST_ACTION" SUCCESS "$DUR"; [ "$LAST_ACTION" != NONE ] && [ "$(uciopt autonomous_root_recovery 0)" = 1 ] && broker_verify_result "$AI_DECISION_SOURCE" "$LAST_ACTION" >/dev/null 2>&1 || true; log "RECOVERED duration=${DUR}s action=$LAST_ACTION"; CUR=HEALTHY; INCIDENT_START=0; RECOVERY_STAGE=0; RECOVERY_STAGE_AT=0; fi;; *) [ "$CAUSE" = NONE ] && CUR=HEALTHY || CUR=DEGRADED;; esac; fi; rootcause_correlate; if [ "$INCIDENT_START" = "$NOW" ] 2>/dev/null; then INCIDENT_CAUSE=$ROOT_REASON; INCIDENT_CONF=$ROOT_CONF; log "OUTAGE domain=$ROOT_DOMAIN reason=$ROOT_REASON confidence=$ROOT_CONF"; fi; [ "$(uciopt adaptive_intelligence 1)" = 1 ] && adaptive_observe; system_learn; maybe_gemini; recovery_orchestrate; printf '%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s,%s\n' "$NOW" "$CUR" "$MODEM_OK" "$SERVICE" "$SIM" "$CONN" "$WANIP" "$RSRP" "$RSRQ" "$RSSI" "$SINR" "$PCI" "$CELL" "$GWOK" "$INET" "$DNSOK" "$SCORE" "$CAUSE" "$CONF" >> "$RING"; L="$(awk 'END{print NR+0}' "$RING" 2>/dev/null)"; [ "${L:-0}" -gt 2401 ] && { head -n1 "$RING" > "$RING.new"; tail -n 2400 "$RING" >> "$RING.new"; mv "$RING.new" "$RING"; }; write_state; [ "$STOP" = 1 ] && break; sleep "$INTERVAL" & wait $!; done
exit 0
