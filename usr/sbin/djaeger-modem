#!/bin/sh
. /usr/lib/djaeger-modem/common.sh
[ -f /usr/lib/djaeger-modem/adaptive.sh ] && . /usr/lib/djaeger-modem/adaptive.sh
[ -f /usr/lib/djaeger-modem/gemini.sh ] && . /usr/lib/djaeger-modem/gemini.sh
VERSION='1.2-rc4'; REPO_RAW='https://raw.githubusercontent.com/Djaeger1/DJAEGER-Modem-Intelligence/main'; cmd="$1"
remote_version(){ wget -qO- --timeout=8 "$REPO_RAW/VERSION" 2>/dev/null | tr -d '\r\n '; }; statev(){ sed -n "s/^$1=//p" "$STATE" 2>/dev/null | head -n1; }
status(){ [ -f "$STATE" ] || { echo 'DJAEGER Modem Intelligence: no state yet'; exit 1; }; state="$(statev state)"; score="$(statev score)"; cause="$(statev cause)"; confidence="$(statev confidence)"; root="$(statev root_domain)"; rr="$(statev root_reason)"; rc="$(statev root_confidence)"; sr="$(statev system_risk)"; ss="$(statev system_reason)"; modem="$(statev modem)"; service="$(statev service)"; sim="$(statev sim)"; wan_ip="$(statev wan_ip)"; rsrp="$(statev rsrp)"; rsrq="$(statev rsrq)"; sinr="$(statev sinr)"; gateway="$(statev gateway)"; internet="$(statev internet)"; dns="$(statev dns)"; self_heal="$(statev self_heal)"; adaptive_samples="$(statev adaptive_samples)"; adaptive_risk="$(statev adaptive_risk)"; adaptive_reason="$(statev adaptive_reason)"; last_action="$(statev last_action)"; recovery_count="$(statev recovery_count)"; recovery_stage="$(statev recovery_stage)"; authority="$(statev ai_authority)"; aisrc="$(statev ai_decision_source)"; aiact="$(statev ai_decision_action)"; aiconf="$(statev ai_decision_confidence)"; cat <<EOF
DJAEGER MODEM INTELLIGENCE v$VERSION
State       : ${state:-UNKNOWN}
Health      : ${score:-0}/100
Cause       : ${cause:-UNKNOWN} (${confidence:-0}%)
Root Cause  : ${root:-UNKNOWN} / ${rr:-UNKNOWN} (${rc:-0}%)
System Risk : ${sr:-0}/100 / ${ss:-UNKNOWN}
Modem       : $([ "$modem" = 1 ] && echo ONLINE || echo OFFLINE)
Service/SIM : ${service:-NA}/${sim:-NA}
WAN IP      : ${wan_ip:-NONE}
Radio       : RSRP=${rsrp:-NA} RSRQ=${rsrq:-NA} SINR=${sinr:-NA}
Gateway     : $([ "$gateway" = 1 ] && echo OK || echo FAIL)
Internet    : $([ "$internet" = 1 ] && echo OK || echo FAIL)
DNS         : $([ "$dns" = 1 ] && echo OK || echo FAIL)
Self-Heal   : $([ "$self_heal" = 1 ] && echo ENABLED-L1 || echo LOCKED)
Modem L2    : $([ "$(uciopt allow_modem_post 0)" = 1 ] && [ "$(uciopt allow_modem_reboot 0)" = 1 ] && echo ENABLED || echo LOCKED)
Adaptive AI : $([ "${adaptive_samples:-0}" -ge "$(uciopt baseline_min_samples 40)" ] 2>/dev/null && echo ACTIVE || echo LEARNING)
AI Risk     : ${adaptive_risk:-0}/100 / ${adaptive_reason:-LEARNING}
AI Authority: ${authority:-SHADOW}
AI Decision : ${aisrc:-NONE} / ${aiact:-NONE} (${aiconf:-0}%)
Recovery    : stage=${recovery_stage:-0} action=${last_action:-NONE} count=${recovery_count:-0}
EOF
}
doctor(){ echo 'DJAEGER DOCTOR'; status; echo; gemini_status 2>/dev/null || true; echo "Daemon      : $(ps w | grep -q '[d]jaeger-modemd' && echo RUNNING || echo STOPPED)"; echo "Root Probe  : $([ -f /usr/lib/djaeger-modem/investigator.sh ] && echo AVAILABLE || echo MISSING)"; echo "Root Broker : $([ -f /usr/lib/djaeger-modem/root-broker.sh ] && echo AVAILABLE || echo MISSING)"; echo "Decision AI : $([ -f /usr/lib/djaeger-modem/decision-engine.sh ] && echo AVAILABLE || echo MISSING)"; echo "System AI   : $([ -f /usr/lib/djaeger-modem/system-intelligence.sh ] && echo AVAILABLE || echo MISSING)"; }
set_gemini_key(){ [ -t 0 ] || { echo 'Interactive terminal required; key is not accepted as a command argument.'; exit 1; }; OLDSTTY="$(stty -g 2>/dev/null || true)"; trap '[ -n "$OLDSTTY" ] && stty "$OLDSTTY" 2>/dev/null || true; unset K' EXIT INT TERM HUP; printf 'Gemini API key: '; stty -echo 2>/dev/null || true; IFS= read -r K; [ -n "$OLDSTTY" ] && stty "$OLDSTTY" 2>/dev/null || stty echo 2>/dev/null || true; printf '\n'; [ -n "$K" ] || { echo 'Empty key rejected'; exit 1; }; printf '%s' "$K" | gemini_set_key; unset K; trap - EXIT INT TERM HUP; echo 'Gemini key stored with local-only permissions. Advisor remains unchanged until explicitly enabled.'; }
gemini_test(){ gemini_enabled || { echo 'Gemini must be configured and enabled first.'; exit 1; }; gemini_advise; echo 'Advisor-only test completed. No recovery action was executed.'; gemini_status; }
case "$cmd" in status|health|'') status;; doctor) doctor;; intelligence|baseline) adaptive_status;; decisions) if [ -f /tmp/djaeger-modem/decision.state ]; then cat /tmp/djaeger-modem/decision.state; else echo 'No AI decision yet'; fi;; gemini) case "$2" in status|'') gemini_status;; set-key) set_gemini_key;; clear-key) gemini_clear_key; uci set djaeger_modem.main.gemini_enabled='0'; uci commit djaeger_modem; echo 'Gemini key removed; advisor disabled.';; enable) [ -s "$GEMINI_KEY" ] || { echo 'Set API key first'; exit 1; }; uci set djaeger_modem.main.gemini_enabled='1'; uci commit djaeger_modem; echo 'Gemini Whole-System Advisor enabled. Recovery authority remains controlled separately.';; disable) uci set djaeger_modem.main.gemini_enabled='0'; uci commit djaeger_modem; echo 'Gemini disabled; Local AI remains active.';; test) gemini_test;; *) echo 'Usage: djaeger-modem gemini {status|set-key|clear-key|enable|disable|test}'; exit 2;; esac;; incidents) tail -n 20 "$INCIDENTS" 2>/dev/null || echo 'No incidents yet';; telemetry) tail -n 20 "$RING" 2>/dev/null || echo 'No telemetry yet';; logs) tail -n 50 "$LOG" 2>/dev/null || echo 'No logs yet';; version) echo "DJAEGER Modem Intelligence v$VERSION";; check-update) REMOTE="$(remote_version)"; echo "Installed: $VERSION"; echo "Available: ${REMOTE:-UNKNOWN}";; start|stop|restart) /etc/init.d/djaeger-modem "$cmd";; *) echo 'Usage: djaeger-modem {status|doctor|intelligence|decisions|gemini|incidents|telemetry|logs|version|start|stop|restart}'; exit 2;; esac
