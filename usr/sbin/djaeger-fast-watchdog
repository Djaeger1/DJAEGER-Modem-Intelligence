#!/bin/sh
# DJAEGER Fast Watchdog v8 - high-frequency observer only.
# Single-writer invariant: only djaeger-modemd may request Root Broker recovery.
STATE=/tmp/djaeger-fast-watchdog.state
CELL_STATE=/tmp/djaeger-modem/cellular-state
CELLENGINE=/usr/lib/djaeger-modem/cellular-state-engine.sh
SLEEP=${DJAEGER_WATCHDOG_INTERVAL:-1}
umask 077
probe(){ ping -c1 -W1 1.1.1.1 >/dev/null 2>&1 || ping -c1 -W1 8.8.8.8 >/dev/null 2>&1; }
ckv(){ sed -n "s/^$1=//p" "$CELL_STATE" 2>/dev/null | head -n1; }
refresh_cellular(){ [ -x "$CELLENGINE" ] && "$CELLENGINE" >/dev/null 2>&1 || return 1; }
write_state(){ T="$STATE.$$"; printf 'state=%s\nupdated=%s\nlast_action=NONE\npolicy_domain=%s\npolicy_source=OBSERVER_ONLY\ncellular_confidence=%s\nauthority=OBSERVER_ONLY\n' "$1" "$(date +%s)" "${DOMAIN:-UNKNOWN}" "${CCONF:-0}" > "$T"; chmod 600 "$T"; mv "$T" "$STATE"; }
DOMAIN=UNKNOWN; CCONF=0; write_state STANDBY
while :; do
  if probe; then write_state HEALTHY; sleep "$SLEEP"; continue; fi
  write_state SUSPECT
  sleep 1
  if probe; then write_state HEALTHY; continue; fi
  if refresh_cellular; then DOMAIN="$(ckv root_domain)"; CCONF="$(ckv confidence)"; [ -n "$DOMAIN" ] || DOMAIN=UNKNOWN; else DOMAIN=UNKNOWN; CCONF=0; fi
  write_state OUTAGE_CONFIRMED
  # No broker_execute here. This daemon is telemetry/reflex detection only.
  sleep "$SLEEP"
done
