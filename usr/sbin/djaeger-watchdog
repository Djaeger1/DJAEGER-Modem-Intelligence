#!/bin/sh
# DJAEGER Connectivity Watchdog v8 - DETECTION ONLY.
# Recovery authority belongs exclusively to djaeger-modemd / Root Broker.
# This process must never call ifup, restart network services, or reboot modem.
STATE=/tmp/djaeger-watchdog.state
LOCK=/tmp/djaeger-watchdog.lock
INTERVAL=2
CONFIRM_DELAY=2
umask 077
mkdir "$LOCK" 2>/dev/null || exit 73
trap 'rm -rf "$LOCK"' EXIT INT TERM
probe_net(){ ping -c1 -W1 1.1.1.1 >/dev/null 2>&1 || ping -c1 -W1 8.8.8.8 >/dev/null 2>&1; }
write_state(){ { echo "updated=$(date +%s)"; echo "state=$1"; echo "last_action=NONE"; echo "authority=OBSERVER_ONLY"; } > "$STATE.tmp"; chmod 600 "$STATE.tmp"; mv "$STATE.tmp" "$STATE"; }
while :; do
  if probe_net; then write_state HEALTHY; sleep "$INTERVAL"; continue; fi
  write_state SUSPECT
  sleep "$CONFIRM_DELAY"
  if probe_net; then write_state HEALTHY; continue; fi
  write_state OUTAGE_CONFIRMED
  # Intentionally no recovery action here. djaeger-modemd owns recovery.
  sleep "$INTERVAL"
done
